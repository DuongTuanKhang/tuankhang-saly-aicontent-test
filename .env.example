# Copy sang .env rồi điền. KHÔNG commit .env.
#
#   cp .env.example .env
#
# Bốn mục bắt buộc để chạy được: PORT, DATABASE_URL(+WORKER), AUTH_*, và một
# nhà cung cấp mô hình ở mục cuối.

PORT=6980

# --- PostgreSQL ---
# Chạy bằng `docker compose -f docker/postgres/compose.yml up -d`.
# Mật khẩu và cổng khớp sẵn với compose, không cần đổi gì.
#
# Hai chuỗi khác nhau ở VAI TRÒ chứ không phải ở database:
#   aicontent_app    — ứng dụng web dùng, KHÔNG có BYPASSRLS
#   aicontent_worker — worker chạy việc nền dùng, có BYPASSRLS
# Ứng dụng web mà nối bằng chuỗi worker là mất lớp phân tách theo không gian
# làm việc. Đừng dán nhầm.
DATABASE_URL=postgresql://aicontent_app:aicontent_test@127.0.0.1:35443/aicontent_test
DATABASE_URL_WORKER=postgresql://aicontent_worker:aicontent_test@127.0.0.1:35443/aicontent_test

# --- Đăng nhập ---
# AUTH_SECRET: sinh bằng `openssl rand -hex 32`. Bất kỳ chuỗi 64 ký tự hex nào
# cũng chạy được trên máy bạn.
AUTH_SECRET=

# PHẢI viết `localhost`, KHÔNG viết `127.0.0.1`. Hai chuỗi này lệch nhau thì
# Auth.js sinh URL gọi ngược không khớp, và thông báo lỗi không nói lệch ở đâu.
AUTH_URL=http://localhost:6980

# Cửa đăng nhập tắt dành riêng cho bài test: mở `http://localhost:6980/api/dev-login`
# là vào thẳng, không cần Google. Xem `app/api/dev-login/route.ts`.
# Tự tắt khi NODE_ENV=production.
AUTH_DEV_LOGIN=1

# --- Gọi mô hình ---
# Bản thật chạy Claude Code CLI / Codex CLI trong container bằng thẻ thuê bao
# cá nhân. Bạn không có thẻ đó, nên dùng đường khoá API: đặt AI_PROVIDER là
# `gemini` hoặc `openai` rồi điền khoá tương ứng.
#
# Gemini có bậc miễn phí, đủ dùng cho bài test: https://aistudio.google.com/apikey
#
# Bỏ trống AI_PROVIDER thì mọi lượt gọi mô hình trả về lỗi "chưa cấu hình" —
# app vẫn chạy, chỉ là không sinh được nội dung.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Ghi đè tên mô hình nếu nhà cung cấp đổi tên. Bỏ trống thì dùng mặc định trong
# `lib/model-runner/runner-api.js`.
# AI_MODEL=

# --- Kéo bài từ nền tảng ngoài (KHÔNG cần cho bài test) ---
# Bản thật kéo bài về bằng Apify và bóc phụ đề bằng ElevenLabs. Bài test không
# cần: `db/seed-test.sql` đã nạp sẵn bài của kênh mình và của kênh đang theo dõi.
# Để trống thì nút "kéo ngay" báo chưa cấu hình, mọi thứ còn lại vẫn chạy.
# APIFY_TOKEN=
# ELEVENLABS_API_KEY=

# Kho ảnh tải về, nằm NGOÀI thư mục mã nguồn. Bỏ trống thì dùng mặc định.
# Đặt trong `public/` là mỗi lần build đè mất.
# KHO_MEDIA=
